---
import { Image } from "astro:assets";
import Link from "@/components/inputs/Link.astro";
import SplitText from "@/components/inputs/SplitText.astro";
import Headshot from "@/images/headshot.jpg";
import Arrow from "@/images/icons/arrow.svg";
import Recurse from "@/images/icons/recurse.svg";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
	<section class="hero-section page-section">
		<div class="container">
			<Image src={Headshot} alt="headshot of briana" width={320} height={320} class="headshot" />
			<div class="text-block">
				<h1 class="h5"><SplitText text="Hi, I'm Bri" /></h1>
				<p>I design and build things for the web, mostly bespoke commerce and brand experiences.</p>
				<!-- <p>I'm currently building a <Link href="https://brianagude.substack.com/p/im-building-an-official-shopify-theme">Shopify theme</Link> to submit to teh theme store.</p> -->
				<p>For over five years I ran my own studio, taking projects from strategy through launch for brands across health, wellness, beauty, and culture. Before that and alongside it, I built conversion-focused <Link href="/work/landing-pages">landing pages</Link> and design systems for DTC brands.</p>
				<p>I spent the winter at Recurse Center building fluency in Three.js, React Three Fiber, and shaders. Some of that work now lives in my <Link href="/work/recurse/">sketchbook</Link>. I also run the weekly creative coding group there.</p>
				<p>I'm open to contract and select agency work right now. If something feels like a fit, <Link href="mailto:work@brianagude.com">say hi</Link> (:</p>
			</div>
		</div>
	</section>
	<section class="experience-section page-section">
		<div class="container">
			<div class="text-block">
				<h2 class="h5"><SplitText text="Experience" /></h2>
				<p><b>Recurse Center</b>, <span class="body-sm">Participant — Nov 2025 to Feb 2026</span><br/>Creative coding and immersive 3D web, Three.js, React Three Fiber, GLSL, Rapier physics. Ran the weekly creative coding group.</p>
				<p><b>CARO Stack</b>, <span class="body-sm">Technical Co-Founder — Dec 2025 to April 2026</span><br/>Conversion studio for DTC brands. Owned all technical architecture and product development.</p>
				<p><b>Dianthe Studio</b>, <span class="body-sm">Founder / Design Engineer — May 2024 to Nov 2025</span><br/>Independent studio for brands and agencies across health, wellness, beauty, and culture, discovery through launch.</p>
				<p><b>Thesis Testing</b>, <span class="body-sm">Design Engineer — July 2019 to May 2024</span><br/>Designed and built conversion-focused landing pages and paid ad creative, managing 20+ active clients at a time.</p>
			</div>
		</div>
	</section>
	<section class="webring">
		<a
			id="rc-ring-prev"
			href="https://ring.recurse.com/prev?id=63"
			target="_blank"
			rel="noopener noreferrer"
			class="arrow arrow-left"
			aria-label="Previous site in the Recurse Center webring (opens in a new tab)"
		>
			<Image src={Arrow} alt="" width={24} height={24}  />
		</a>

		<a
			href="https://www.recurse.com/scout/click?t=49255f4a45abaf728b468df6b7d6abf3"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Recurse Center (opens in a new tab)"
		>
			<Image src={Recurse} alt="" width={32} height={40} />
		</a>

		<a
			id="rc-ring-next"
			href="https://ring.recurse.com/next?id=63"
			target="_blank"
			rel="noopener noreferrer"
			class="arrow arrow-right"
			aria-label="Next site in the Recurse Center webring (opens in a new tab)"
		>
			<Image src={Arrow} alt="" width={24} height={24}  />
		</a>
	</section>
	<script is:inline defer src="https://raw.githack.com/Qwuke/recurse-ring/main/static/ring.js"></script>
</BaseLayout>

<style lang="scss">
  @use "@/styles/_components.scss" as *;
	@use "@/styles/_variables.scss" as *;

	.page-section {
		// min-height: 90svh;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.hero-section {
		height: 100%;
		// flex-grow: 1;
		
		.container {
			// padding-bottom: 80px;
			display: flex;
			flex-direction: column;
		}
	}

	.headshot {
		width: 120px;
		height: 120px;
		border-radius: 100%;
		border: 1px solid $black;
		margin-inline: auto;
	}

	.text-block {
		text-align: center;
		p {
			margin-block: 16px 0;
			margin-inline: auto;
			text-align: start;
		}
	}
	.webring {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 16px;
		padding: 16px;
	}

	.arrow {
		@include pill-link;
		display: inline-block;
		padding-block: 4px;
		padding-inline: 16px;
		transition: all ease 0.2s;
		&:hover {
			transform: translateY(-2px);
		}
	}

	.arrow-left {
		img {
			transform: rotate(-90deg)
		}
	}
	.arrow-right {
		img {
			transform: rotate(90deg)
		}
	}
</style>