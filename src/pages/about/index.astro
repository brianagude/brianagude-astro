---
import Link from "@/components/inputs/Link.astro";
import SplitText from "@/components/inputs/SplitText.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import Headshot from "@/images/headshot.jpg"
import Arrow from "@/images/icons/arrow.svg"
import Recurse from "@/images/icons/recurse.svg"
---

<BaseLayout>
	<section class="hero-section page-section">
		<div class="container">
			<Image src={Headshot} alt="headshot of briana" width={320} height={320} class="headshot" />
			<div class="text-block">
				<h1 class="h5"><SplitText text="Hi, I'm Bri" /></h1>
				<p>A designer, engineer, and Shopify developer based in Atlanta.</p>
				<p>I help agencies, nonprofits, and founders create marketing & ecommerce experiences that are conversion-focused, technically considered, and feel like a natural extension of their brand.</p>
				<p>My work is a product of design, engineering, and creative curiosity, and I'm at my best on projects with room to actually think.</p>
				<p>Right now, I'm studying computational media, and building my first Shopify Theme to submit to the theme library! I'm also open to freelance / contract remote roles in design, engineering, and creative technology.</p>
				<p>If you're interested in working with me, or just want to chat, <Link href="mailto:work@brianagude.com">say hi</Link> (:</p>
			</div>
		</div>
	</section>
	<section class="webring">
		<a 
			id="rc-ring-prev" 
			href="https://ring.recurse.com/prev?id=63" 
			target="_blank"
			rel="noopener noreferrer" 
			class="arrow arrow-left"
		>
			<Image src={Arrow} alt="Arrow Icon" width={24} height={24}  />
		</a>

		<a 
			href="https://www.recurse.com/scout/click?t=49255f4a45abaf728b468df6b7d6abf3" 
			target="_blank"
			rel="noopener noreferrer"
		>
			<Image src={Recurse} alt="Arrow Icon" width={32} height={40} />
		</a>
<!-- 
		<a id="rc-ring-rand" href="https://ring.recurse.com/rand" target="_blank"
rel="noopener noreferrer">
			<Image src={Recurse} alt="Arrow Icon" width={32} height={40} />
		</a> -->

		<a 
			id="rc-ring-next" 
			href="https://ring.recurse.com/next?id=63" 
			target="_blank"
			rel="noopener noreferrer" 
			class="arrow arrow-right"
		>
			<Image src={Arrow} alt="Arrow Icon" width={24} height={24}  />
		</a>
	</section>
</BaseLayout>

<style lang="scss">
  @use "@/styles/_components.scss" as *;
	@use "@/styles/_variables.scss" as *;

	.page-section {
		min-height: 90svh;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.hero-section {
		height: 100%;
		flex-grow: 1;
		
		.container {
			padding-bottom: 80px;
			display: flex;
			flex-direction: column;
		}
	}

	.headshot {
		width: 120px;
		height: 120px;
		border-radius: 100%;
		border: 1px solid $black;
		margin: 0 auto;
	}

	.text-block {
		text-align: center;
		p { 
			margin: 16px auto 0; 
			text-align: left; 
		}
	}
	.webring {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 16px;
		padding: 16px;
	}

	.arrow {
		@include pill-link;
		display: inline-block;
		padding: 4px 16px;
		transition: all ease 0.2s;
		&:hover {
			transform: translateY(-2px);
		}
	}

	.arrow-left {
		img {
			transform: rotate(-90deg)
		}
	}
	.arrow-right {
		img {
			transform: rotate(90deg)
		}
	}

	.accordion-section {
		.container {
			flex-direction: column;
			gap: 0;
		}
	}

	.accordion {
		margin-top: 40px;
	}

	details {
		max-width: 500px;
		margin: 0 auto;
		border-bottom: 2px solid $black;
		interpolate-size: allow-keywords;
		
		@include mq("sm") {
			max-width: 560px;
		}
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.25rem 0;
		cursor: pointer;
		list-style: none;

		&::-webkit-details-marker {
			display: none;
		}

		h3 {
			margin: 0;
		}

		&::after {
			content: '+';
			font-size: 1.5rem;
			line-height: 1;
			flex-shrink: 0;
		}
	}

	details[open] summary::after {
		content: '−';
	}

	::details-content {
		height: 0;
		overflow: hidden;
		opacity: 0;
		transition: height 0.35s ease, opacity 0.35s ease, content-visibility 0.35s allow-discrete;
	}

	details[open]::details-content {
		height: auto;
		opacity: 1;
	}

	@starting-style {
		details[open]::details-content {
			height: 0;
			opacity: 0;
		}
	}

	.accordion-body {
		padding-bottom: 1.25rem;

		p, ul {
			margin-top: 0;
			margin-bottom: 0.75rem;

			&:last-child {
				margin-bottom: 0;
			}
		}

		ul {
			padding-left: 1.25rem;

			// @include mq("lg") {
			// 	display: grid;
			// 	grid-template-columns: 1fr 1fr;
			// }
		}

		li + li {
			margin-top: 0.75rem;
		}
	}
</style>