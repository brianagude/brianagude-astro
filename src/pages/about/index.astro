<style lang="scss">
  @use "@/styles/_components.scss" as *;
	@use "@/styles/_variables.scss" as *;

	.page-section {
		min-height: 90svh;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.hero-section {
		height: 100%;
		flex-grow: 1;
		
		.container {
			padding-bottom: 80px;
			display: flex;
			flex-direction: column;
		}
	}

	.headshot {
		width: 120px;
		height: 120px;
		border-radius: 100%;
		border: 1px solid $black;
		margin: 0 auto;
	}

	.text-block {
		text-align: center;
		p { 
			margin: 16px auto 0; 
			text-align: left; 
		}
	}
	.webring {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 16px;
		padding: 16px;
	}

	.arrow {
		@include pill-link;
		display: inline-block;
		padding: 4px 16px;
		transition: all ease 0.2s;
		&:hover {
			transform: translateY(-2px);
		}
	}

	.arrow-left {
		img {
			transform: rotate(-90deg)
		}
	}
	.arrow-right {
		img {
			transform: rotate(90deg)
		}
	}

	.accordion-section {
		.container {
			flex-direction: column;
			gap: 0;
		}
	}

	.accordion {
		margin-top: 40px;
	}

	details {
		max-width: 500px;
		margin: 0 auto;
		border-bottom: 2px solid $black;
		interpolate-size: allow-keywords;
		
		@include mq("sm") {
			max-width: 560px;
		}
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.25rem 0;
		cursor: pointer;
		list-style: none;

		&::-webkit-details-marker {
			display: none;
		}

		h3 {
			margin: 0;
		}

		&::after {
			content: '+';
			font-size: 1.5rem;
			line-height: 1;
			flex-shrink: 0;
		}
	}

	details[open] summary::after {
		content: '−';
	}

	::details-content {
		height: 0;
		overflow: hidden;
		opacity: 0;
		transition: height 0.35s ease, opacity 0.35s ease, content-visibility 0.35s allow-discrete;
	}

	details[open]::details-content {
		height: auto;
		opacity: 1;
	}

	@starting-style {
		details[open]::details-content {
			height: 0;
			opacity: 0;
		}
	}

	.accordion-body {
		padding-bottom: 1.25rem;

		p, ul {
			margin-top: 0;
			margin-bottom: 0.75rem;

			&:last-child {
				margin-bottom: 0;
			}
		}

		ul {
			padding-left: 1.25rem;

			// @include mq("lg") {
			// 	display: grid;
			// 	grid-template-columns: 1fr 1fr;
			// }
		}

		li + li {
			margin-top: 0.75rem;
		}
	}
</style>