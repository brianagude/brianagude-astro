---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SplitText from "@/components/inputs/SplitText.astro";
import Link from "@/components/inputs/Link.astro";

const response = await fetch("https://api.giphy.com/v1/gifs/random?api_key=X6MM2MOO08maHraBhB5Gb4ump5fuaDMs&tag=error&rating=g");
const data = await response.json();
const randomGif = data.data;
const gifUrl = randomGif?.images?.fixed_height?.url;
---

<BaseLayout title='404 | briana&apos;s portfolio'>
  <section class="page-section text-section">
    <div class="container centered">
      <h1 class="h6"><SplitText text="OMG!" /></h1>
      {gifUrl && (
        <figure>
          <img src={gifUrl} alt="A random error gif" />
          <figcaption>Powered By GIPHY</figcaption>
        </figure>
      )}
      <p>Something unexpected happened.<br/>Please go back <Link href="/">home</Link>!</p>
    </div>
  </section>

</BaseLayout>

<style lang="scss">
  @use "@/styles/_components.scss" as *;
	@use "@/styles/_variables.scss" as *;

  .text-section { 
    margin: auto auto;
    width: 100%;
  }

  figure {

    img {
      max-height: 200px;
      object-fit: contain;
      border: 1px solid $black;
      border-radius: 8px;
    }

    figcaption { 
      margin-top: 4px;
      text-transform: uppercase;
      font-size: 0.6rem;
      font-weight: 500;
      line-height: 1.625;
      text-align: end;
    }
  }
</style>