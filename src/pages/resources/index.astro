---
import Link from "@/components/inputs/Link.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SplitText from "@/components/inputs/SplitText.astro";
---

<BaseLayout title="resources | briana gude">
	<section class="page-section text-section">
		<div class="container centered">
			<h1 class="h6"><SplitText text="Resources" /></h1>
		</div>
	</section>
	<section class="page-section">
		<div class="container">
			<nav aria-label="My stuff">
				<h2 class="caption-sm">my stuff</h2>
				<ul>
					<li><Link href="/tags/experiments">experiments</Link></li>
					<li><Link href="/">my portfolio</Link></li>
					<li><Link href="https://brianagude.substack.com/">my blog</Link></li>
				</ul>
			</nav>
			<nav aria-label="Resources">
				<h2 class="caption-sm">resources</h2>
				<ul>
					<li><Link href="https://thebookofshaders.com">the book of shaders</Link></li>
					<li><Link href="https://natureofcode.com/">nature of code</Link></li>
					<li><Link href="https://threejs-journey.com/">three js journey</Link></li>
					<li><Link href="https://www.youtube.com/watch?v=AwKgrjHrpcY">just do it</Link></li>
					<li><Link href="https://newincreative.notion.site/The-Vault-Nguyen-s-Design-Resource-stash-dd710673638a4c16a571574ff72d05f9">design vault</Link></li>
				</ul>
			</nav>
		</div>
	</section>
</BaseLayout>

<style lang="scss">
  @use "@/styles/_components.scss" as *;
	@use "@/styles/_variables.scss" as *;

	.text-section { padding-block-end: 0; }

	nav {
		display: block;
		text-align: center;
		margin-inline: auto;

		& + nav {
			margin-block-start: 40px;
		}
	}

	h2 {
		margin-block-end: 12px;
	}

	ul {
		list-style-type: none;
		margin-inline: auto;
	}

	li {
		margin-inline: auto;

		& + li {
			margin-block-start: 12px;
		}
	}

	a {
		@include pill-link;
	}
</style>