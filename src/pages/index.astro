---
import { getCollection } from "astro:content";

import Card from "@/components/inputs/Card.astro";
import SplitText from "@/components/inputs/SplitText.astro";
import Tags from "@/components/Tags.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPostUrl } from "@/utils";

const workPosts = await getCollection("work");
const sortedWork = workPosts.sort((a, b) => 
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout>
  <section class="page-section text-section">
    <div class="container centered">
      <div>
        <h1 class="h6"><SplitText text="Briana Gude" /></h1>
        <p>Design & Technology</p>
      </div>
    </div>
  </section>
  <section class="page-section all-projects">
    <Tags/>
    <div class="container grid">
      {sortedWork.map((post: any, i: number) => <Card url={getPostUrl(post)} title={post.data.title} image={post.data.image} video={post.data.mux_id} index={i} />)}
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use "@/styles/_components.scss" as *;
	@use "@/styles/_variables.scss" as *;

  .text-section { padding-block-end: 0; }
</style>