---
import { getCollection } from "astro:content";

import Card from "@/components/inputs/Card.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SplitText from "@/components/inputs/SplitText.astro";
import { getPostUrl } from "@/utils"

const caseStudyPosts = await getCollection("caseStudies");
const workPosts = await getCollection("work");
const sortedcaseStudyPosts = caseStudyPosts.sort((a, b) => 
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const sortedworkPosts = workPosts.sort((a, b) => 
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allPosts = [...sortedcaseStudyPosts, ...sortedworkPosts];
const pageTitle = "briana's work";
---

<BaseLayout title={pageTitle}>
  <section class="page-section text-section">
    <div class="container centered">
      <div>
        <h1 class="h6"><SplitText text="Selected Work" /></h1>
        <!-- <p>for other people.</p> -->
        <!-- <h1 class="h6"><SplitText text="Things I Made" /></h1>
        <p>for other people.</p> -->
      </div>
    </div>
  </section>
  <section class="page-section">
    <div class="container grid">
      {allPosts.sort().map((post: any, i: number) => <Card url={getPostUrl(post)} title={post.data.title} image={post.data.image} video={post.data.mux_id} index={i} />)}
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use "@/styles/_components.scss" as *;
  .text-section { padding-bottom: 0; }
</style>