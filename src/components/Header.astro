---
import Navigation from "./inputs/Navigation.astro";

const links = [
	{
		text: "work",
		url: "/",
	},
	{
		text: "about",
		url: "/about",
	},
];
---
<header transition:persist>
  <div class="container">
    <Navigation links={links} ariaLabel="Main navigation" />
  </div>
</header>

<style lang="scss">
  @use "@/styles/_variables.scss" as *;

  header {
    position: sticky;
    inset-block-start: 0;
    inset-inline-start: 0;
    width: 100%;
    z-index: 50;

    img {
      border: 1px solid $black;
      border-radius: 100%;
    }
  }

  .container {
    padding-block: 8px;
    padding-inline: 16px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    max-width: $bp-xl;
    margin-inline: auto;
  }

  .logo {
    display: flex;
    flex-direction: column; 
    align-items: center;
    gap: 12px;
    display: none;

    @include mq("md") { 
      display: inline-block;
    }
  }

  p { line-height: 1.2; }
  a { line-height: 1; }
  b { font-weight: 500; }
</style>