---
const { title, index = 0 } = Astro.props;
import { getCollection } from "astro:content";
import { getPostUrl } from "@/utils"

const caseStudyPosts = await getCollection("caseStudies");
const workPosts = await getCollection("work");
const experimentPosts = await getCollection("experiments");

const sortedCaseStudies = caseStudyPosts.sort((a, b) => 
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const sortedWork = workPosts.sort((a, b) => 
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const sortedExperiments = experimentPosts.sort((a, b) => 
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const allPosts = [...sortedCaseStudies, ...sortedExperiments, ...sortedWork,];

---

<section class="project-nav">
  <p>project nav</p>

</section>