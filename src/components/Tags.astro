---
import { getCollection } from "astro:content";

const workPosts = await getCollection("work");

const tags = [...new Set(workPosts.flatMap((post: any) => post.data.tags ?? []))].sort();

const currentPath = Astro.url.pathname;
---

<section>
  <div class="link-list">
    <a
      href='/'
      data-portfolio-tag="all"
      class:list={["font-mono", { selected: currentPath === '/' }]}
    >
      <div class="dot">
        <div class="inner-dot"/>
      </div>
      All
    </a>

    {tags.map((tag) => {
      const href = `/tags/${tag}`;
      const isActive = currentPath.includes(href);
      return (
        <a
          href={href}
          data-portfolio-tag={tag}
          class:list={["font-mono", { selected: isActive }]}
        >
          <div class="dot">
            <div class="inner-dot"/>
          </div>
          {tag.replaceAll('-', ' ')}
        </a>
      );
    })}
  </div>
</section>

<script>
  function initPortfolioTagTracking() {
    document.querySelectorAll<HTMLAnchorElement>("[data-portfolio-tag]").forEach((tag) => {
      if (tag.dataset.analyticsBound) return;
      tag.dataset.analyticsBound = "true";

      tag.addEventListener("click", () => {
        const selectedTag = tag.dataset.portfolioTag;

        window.posthog?.logger?.info("Portfolio tag filtered", {
          selected_tag: selectedTag,
        });
        window.posthog?.capture("portfolio_tag_filtered", {
          selected_tag: selectedTag,
        });
        if (selectedTag === "experiments") {
          window.posthog?.register_once({ visitor_intent: "inspiration" });
        }
      });
    });
  }

  initPortfolioTagTracking();
  document.addEventListener("astro:page-load", initPortfolioTagTracking);
</script>

<style lang="scss">
  @use "@/styles/_components.scss" as *;
	@use "@/styles/_variables.scss" as *;

  section {
    margin-block-end: 40px;
  }

  .link-list {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    column-gap: 16px;
    row-gap: 8px;
    padding-inline: 1rem;
    width: 100%;
    max-width: 640px;
    margin-inline: auto;

    @include mq("sm") {
      padding-inline: 1.5rem;
    }

    @include mq("lg") {
      padding-inline: 2rem;
    }
  }

  a {
    display: flex;
    align-items: center;
    gap: 4px;
    text-transform: capitalize;
    
    &:hover, &.selected {
      font-weight: bold;
      .inner-dot { opacity: 100% !important; }
    }
  }


  .dot {
    width: 16px;
    height: 16px;
    border: 1px solid $black;
    border-radius: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2px;

    
  }

  .inner-dot {
    width: 100%;
    height: 100%;
    background: $black;
    border-radius: 100%;
    opacity: 0;
  }


</style>