---
const { url, title, image, video, date, index = 0 } = Astro.props;
import { Image } from "astro:assets";
import Mux from "./Mux.astro";
import FormattedDate from "./FormattedDate.astro";
import Link from "@/components/inputs/Link.astro"
---

<Link href={url} aria-label={title} class="card-wrapper" style={`--index: ${index}`}>
  <div class="media">
    {video && <Mux playbackId={video} title={title} class="main-video" />}
    {image && !video && (
      <>
        <Image src={image.url} alt="" aria-hidden="true" class="placeholder-img" width={32} quality={20} loading="eager" decoding="sync" />
        <Image src={image.url} alt={image.alt} class="main-img" width={1200} height={680} />
      </>
    )}
  </div>
  <div class="content">
    <span class="body-lg title">{title}</span>
    {date && <span class="body-sm"><FormattedDate date={date} /></span>}
  </div>
</Link>

<style lang="scss">
  @use "@/styles/_variables.scss" as *;

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  a {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: all 0.3s ease-in-out;
    opacity: 0;
    animation: card-in 0.4s ease-out forwards;
    animation-delay: calc(var(--index, 0) * 80ms);

    &:hover {
      .media {
        transform: translate(-4px, -4px);
        box-shadow: 4px 4px 0px rgba(4,6,2,0.25);
        border-radius: 40px;
        
      }

      .title {
        font-weight: 700;
      }
    }
  }

  .media {
    aspect-ratio: 16/9;
    border-radius: 24px;
    border: 1px solid $black;
    transition: all 0.2s ease-in-out;
    overflow: hidden;
    position: relative;
  }

  .placeholder-img {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(20px);
    transform: scale(1.15);
  }

  img, video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .content {
    display: flex;
    flex-direction: column;
    text-align: center; 
  }

  span {
    transition: all 0.3s ease-in-out;
  }
</style>