---
const { playbackId, title } = Astro.props;
const posterTiny = `https://image.mux.com/${playbackId}/thumbnail.jpg?width=32`;
const poster = `https://image.mux.com/${playbackId}/thumbnail.jpg?width=1200`;
---

<div class="mux-wrapper">
  <div class="poster-tiny" style={`background-image: url('${posterTiny}')`}></div>
  <mux-player
    playback-id={playbackId}
    metadata-video-title={title}
    poster={poster}
    autoPlay="muted"
    loop
    muted
    nohotkeys
  ></mux-player>
</div>

<style>
  .mux-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .poster-tiny {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center;
    filter: blur(20px);
    transform: scale(1.15);
  }

  mux-player {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
  }
</style>
