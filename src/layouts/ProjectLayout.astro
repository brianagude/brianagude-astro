---
import { getCollection } from "astro:content";

import BaseLayout from "./BaseLayout.astro";
import Link from "@/components/inputs/Link.astro";
import FormattedDate from "@/components/inputs/FormattedDate.astro";
import { Image } from "astro:assets";
import Mux from "@/components/inputs/Mux.astro";
import Arrow from "@/images/icons/arrow.svg"

const { frontmatter } = Astro.props;

const workPosts = await getCollection("work");
const sortedWork = workPosts.sort((a, b) => 
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const currentIdx = sortedWork.findIndex(item => item.data.title === frontmatter.title);
const prevIdx = currentIdx === 0 
  ? sortedWork[sortedWork.length - 1] 
  : sortedWork[currentIdx - 1];

const nextIdx = currentIdx === sortedWork.length - 1 
  ? sortedWork[0] 
  : sortedWork[currentIdx + 1];
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <section class="project page-section">
    <div class="container">
      <div class="header">
        <h1>{frontmatter.title}</h1>
        {frontmatter.description && <p class="subtitle">{frontmatter.description}</p>}
        <div class="info">
          <p class="body-sm">
            <FormattedDate date={frontmatter.pubDate} format="month-year" />
            {frontmatter.endDate && <> &mdash; <FormattedDate date={frontmatter.endDate} format="month-year" /></>}
          </p>
          <Link href={`${frontmatter.url}?utm_source=brianagude.com`}>View Project</Link>
        </div>
      </div>
      <div class="media">
        {frontmatter.mux_id && <Mux playbackId={frontmatter.mux_id} title={frontmatter.title} class="main-video" />}
        {frontmatter.image && !frontmatter.mux_id && (
          <>
            <Image src={frontmatter.image.url} alt="" aria-hidden="true" class="placeholder-img" width={32} quality={20} loading="eager" decoding="sync" />
            <Image src={frontmatter.image.url} alt={frontmatter.image.alt} class="main-img" loading="eager" fetchpriority="high" />
          </>
        )}
      </div>
      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
  <div class="navigation">
    <Link href={`/work/${prevIdx.id}`} class="arrow arrow-left" aria-label={`Previous project: ${prevIdx.data.title}`}>
      <Image src={Arrow} alt="" width={24} height={24}  />
    </Link>
    <p class="body-sm">{currentIdx + 1} / {sortedWork.length}</p>
    <Link href={`/work/${nextIdx.id}`} class="arrow arrow-right" aria-label={`Next project: ${nextIdx.data.title}`}>
      <Image src={Arrow} alt="" width={24} height={24}  />
    </Link>
  </div>
</BaseLayout>

<style lang="scss">
  @use "@/styles/_components.scss" as *;
  @use "@/styles/_variables.scss" as *;
  @use "@/styles/_typography" as *;

  .container {
    max-width: $bp-sm !important;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .subtitle {
    font-size: 16px;
    margin-block: 0 8px;
  }

  .media {
    aspect-ratio: 16/9;
    border-radius: 24px;
    border: 1px solid $black;
    transition: all 0.2s ease-in-out;
    overflow: hidden;
    margin-block-start: 12px;
    position: relative;
    isolation: isolate;
  }

  .placeholder-img {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(20px);
    transform: scale(1.15);
  }

  .main-img {
    object-fit: contain;
    height: auto;
    width: 100%;
  }

  .info {
    display: flex;
    flex-direction: row;
    justify-content: space-between;

    a {
      @include pill-link;
    }
  }

  .prose {
    margin-block-start: 24px;

    p {
      font-size: 0.875rem;
      line-height: 1.625;
      max-width: 60ch;
      text-wrap: pretty;
    }
  }

  .navigation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    max-width: $bp-sm !important;
    width: 100%;
    margin-inline: auto;
    margin-block: auto 24px;

    // a {
    //   @include pill-link;
    // }
  }

  .arrow {
		@include pill-link;
		display: inline-block;
		padding-block: 4px;
		padding-inline: 16px;
		transition: all ease 0.2s;
		&:hover {
			transform: translateY(-2px);
		}
	}

	.arrow-left {
		img {
			transform: rotate(-90deg)
		}
	}
	.arrow-right {
		img {
			transform: rotate(90deg)
		}
	}
</style>